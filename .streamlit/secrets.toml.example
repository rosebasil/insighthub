# Copy this file to .streamlit/secrets.toml (gitignored - never commit real
# credentials) for local development, or paste the equivalent TOML into your
# hosting platform's secrets manager (e.g. Streamlit Community Cloud's
# "Secrets" settings) for a deployed app.
#
# See README.md -> "Connecting real data sources" for exactly what each
# credential needs to be able to do (and the one-time request to send your
# Snowflake administrator).

[snowflake]
account = "your_account_identifier"      # e.g. "ANB64356" (see Snowflake account URL)
user = "your_service_account_user"
password = "your_password"                # or use private_key_path + private_key_passphrase for key-pair auth
role = "ROLE_MARKET_INTELLIGENCE"          # or a narrower read-only role scoped to JEENY_PROD.GENERAL.FEEDBACKEVENTS
warehouse = "COMPUTE_WH"
login_timeout = 10

# [surveymonkey]
# access_token = "your_surveymonkey_oauth_token"   # see README for required scopes
