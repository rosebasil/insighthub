# Copy this file to .streamlit/secrets.toml (gitignored - never commit real
# credentials) for local development, or paste the equivalent TOML into your
# hosting platform's secrets manager (e.g. Streamlit Community Cloud's
# "Secrets" settings) for a deployed app.
#
# See README.md -> "Connecting real data sources" for exactly what each
# credential needs to be able to do (and the one-time request to send your
# Snowflake administrator).

[snowflake]
account = "your_account_identifier"      # e.g. "ANB64356" (see Snowflake account URL)
user = "your_service_account_user"
password = "your_password"                # or use private_key_path + private_key_passphrase for key-pair auth
role = "ROLE_MARKET_INTELLIGENCE"          # or a narrower read-only role scoped to JEENY_PROD.GENERAL.FEEDBACKEVENTS
warehouse = "COMPUTE_WH"
login_timeout = 10

# [surveymonkey]
# access_token = "your_surveymonkey_oauth_token"   # see README for required scopes

# [google_drive]
# folder_id = "your_shared_drive_folder_id"          # the folder id from its URL
# service_account_json = '''
# {"type": "service_account", "project_id": "...", "private_key_id": "...", ...}
# '''
# # Paste the *entire* service-account key JSON (downloaded once when the key
# # is created) as one TOML triple-quoted string. See README's "Connecting
# # real data sources" -> Google Drive for the one-time setup: create the
# # service account, download this key, and share the Drive folder with the
# # service account's email (it looks like name@project.iam.gserviceaccount.com).

# [google_sheets]
# spreadsheet_id = "your_spreadsheet_id"              # the id from the sheet's URL
# worksheet_range = "Issues!A:Z"                        # optional - defaults to "A:Z" on the first sheet
# service_account_json = '''
# {"type": "service_account", "project_id": "...", "private_key_id": "...", ...}
# '''
# # Can reuse the same service-account key as [google_drive] above, or a
# # separate one - either way it needs Viewer access on the WhatsApp/
# # technical issues sheet (share it with the key's
# # name@project.iam.gserviceaccount.com). See README's "Connecting real
# # data sources" -> Google Sheets for the one-time setup.

# [anthropic]
# api_key = "your_anthropic_api_key"                 # only needed for the optional "Analyze with Claude" button
# model = "claude-sonnet-5"                            # optional override
